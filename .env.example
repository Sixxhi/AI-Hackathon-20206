# Copy to .env and fill in. .env is gitignored — never commit real keys.
# v1 needs NONE of these (runs on the mock agent). Fill per lane as you integrate.

# P3 — real agent + outcome signal (replaces mock in immune/agent.py)
ANTHROPIC_API_KEY=

# P3 — eval / tracing
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# P2 — memory store + prefix cache
REDIS_URL=redis://localhost:6379/0

# P2 — quarantine alerting
SENTRY_DSN=

# tunables (optional)
IMMUNE_TRUST_THRESHOLD=0.3
