# Copy to .env and fill in. .env is gitignored — never commit real keys.
# v1 needs NONE of these (runs on the mock agent). Fill per lane as you integrate.

# P3 — LLM provider, models, and keys are all swappable (see immune/config.py)
IMMUNE_LLM_PROVIDER=anthropic          # anthropic | openai | google
ANTHROPIC_API_KEY=                     # set the key for whichever provider you pick
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
IMMUNE_AGENT_MODEL=claude-haiku-4-5-20251001   # agent-under-test (cheap/fast)
IMMUNE_JUDGE_MODEL=claude-sonnet-4-6           # eval/judge (bigger = more reliable)

# P3 — eval / tracing
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
ARIZE_API_KEY=
ARIZE_SPACE_ID=                        # from: ax spaces list
ARIZE_PROJECT_NAME=immune

# P2 — memory store + prefix cache
REDIS_URL=redis://localhost:6379/0

# P2 — quarantine alerting
SENTRY_DSN=

# tunables (optional)
IMMUNE_TRUST_THRESHOLD=0.3
